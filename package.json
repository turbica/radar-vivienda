{
  "name": "radar-vivienda",
  "version": "0.1.0",
  "private": true,
  "description": "Radar de Presión Residencial, Desplazamiento Comercial y Equidad de Barrio en València",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/turbica/radar-vivienda.git"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "collect": "node --experimental-strip-types ./src/index.ts collect",
    "process": "node --experimental-strip-types ./src/index.ts process",
    "data:sync": "node --experimental-strip-types ./src/sync-releases.ts",
    "dev": "node ./web/node_modules/astro/astro.js dev --root ./web",
    "build": "node ./web/node_modules/astro/astro.js build --root ./web",
    "preview": "node ./web/node_modules/astro/astro.js preview --root ./web",
    "test": "node --experimental-strip-types --test ./src/test/*.test.ts",
    "typecheck": "tsc -p src/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.2"
  }
}
