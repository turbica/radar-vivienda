# Directorio base de datos (por defecto ./data en la raíz del proyecto)
DATA_DIR=./data

# Driver de almacenamiento: "local" (por defecto) o "gcs" (híbrido local + Google Cloud Storage)
STORAGE_DRIVER=local

# Opcional: Configuración de Google Cloud Storage (solo si STORAGE_DRIVER=gcs)
GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=

# Opcional: Repositorio público desde el que sincronizar snapshots históricos (GitHub Releases)
GITHUB_SNAPSHOTS_REPO=turbica/radar-vivienda

# Intervalo del colector en modo daemon de Docker Compose (en segundos, por defecto 604800 = 7 días)
COLLECTOR_INTERVAL_SECONDS=604800

# Puerto del servidor web en contenedor
PORT=8080
