---
import PublicLayout from "../layouts/PublicLayout.astro";
import { ObservatoryApp } from "../components/ObservatoryApp";
import { loadObservatoryData } from "../lib/data";
import { ISVP_LEVELS } from "../lib/metrics-catalog";

const { resumen, benchmarks, dataBaseUrl } = await loadObservatoryData();

const pageTitle =
  "Radar Vivienda València — Observatorio de Presión Residencial, Comercio y Equidad de Barrio";
const pageDescription =
  "Observatorio público y abierto sobre viviendas turísticas (GVA tur-gestur-vt), desplazamiento comercial y vulnerabilidad urbana en los 88 barrios de València.";
---

<PublicLayout
  title={pageTitle}
  description={pageDescription}
  currentPath="/"
  snapshotFile={resumen.latestSnapshot.fileName}
  snapshotSha256={resumen.latestSnapshot.sha256}
  updatedAt={resumen.updatedAt}
>
  <!-- HERO EJECUTIVO INSTITUCIONAL (0 JS, LCP Instantáneo) -->
  <section class="civic-grid-bg border-b border-slate-800 text-white">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:py-12">
      <div class="grid gap-8 lg:grid-cols-12 lg:items-center">
        <div class="space-y-4 lg:col-span-8">
          <div class="flex flex-wrap items-center gap-2">
            <span class="rounded-full bg-sky-500/20 px-3 py-1 text-xs font-bold text-sky-300 ring-1 ring-sky-400/30">
              Observatorio Cívico de Datos Abiertos · València
            </span>
            <span class="rounded-full bg-amber-500/20 px-3 py-1 font-mono text-xs font-semibold text-amber-200 ring-1 ring-amber-400/30">
              88 Barrios · 19 Distritos · 26 Códigos Postales
            </span>
          </div>

          <h1 class="text-2xl font-extrabold tracking-tight text-white sm:text-4xl lg:leading-[1.15]">
            Radar de Presión Residencial, Desplazamiento Comercial y Equidad de Barrio
          </h1>

          <p class="max-w-3xl text-sm leading-relaxed text-slate-300 sm:text-base">
            Plataforma pública de seguimiento longitudinal que cruza cada semana el
            registro autonómico de <strong>Viviendas de Uso Turístico (GVA)</strong> con
            el catálogo municipal de <strong>actividad comercial (IAE y terrazas)</strong>,
            <strong>quejas vecinales de convivencia</strong> y <strong>vulnerabilidad socioeconómica</strong> en cada barrio de València.
          </p>

          <div class="flex flex-wrap items-center gap-3 pt-1">
            <a
              href="#estacion-cartografica"
              class="interactive-btn inline-flex min-h-[44px] items-center gap-2 rounded-xl bg-sky-500 px-5 py-2.5 text-xs font-extrabold text-slate-950 shadow-sm hover:bg-sky-400 sm:text-sm"
            >
              <span>Explorar Mapa y Barrios</span>
            </a>
            <a
              href="/metodologia"
              class="interactive-btn inline-flex min-h-[44px] items-center gap-2 rounded-xl border border-slate-700 bg-slate-900/90 px-4 py-2.5 text-xs font-bold text-slate-100 hover:bg-slate-800 sm:text-sm"
            >
              <span>¿Qué significa cada métrica? (Guía Ciudadana)</span>
            </a>
            <a
              href="/analisis"
              class="interactive-btn inline-flex min-h-[44px] items-center gap-2 rounded-xl border border-slate-700/80 bg-slate-900/50 px-4 py-2.5 text-xs font-semibold text-slate-200 hover:bg-slate-800 sm:text-sm"
            >
              <span>Ver evolución 2015–2026</span>
            </a>
          </div>
        </div>

        <!-- Resumen ejecutivo lateral en el Hero -->
        <div class="rounded-2xl border border-slate-800 bg-slate-900/90 p-5 shadow-lg lg:col-span-4">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <span class="text-xs font-bold tracking-wider text-sky-400 uppercase">
              Radiografía Actual de València
            </span>
            <span class="font-mono text-[11px] text-slate-300">
              Media ISVP: <strong class="text-white">{benchmarks.avgIsvp}/100</strong>
            </span>
          </div>

          <dl class="mt-3.5 grid grid-cols-2 gap-3 text-xs">
            <div class="rounded-xl bg-slate-950/70 p-3 border border-slate-800/80">
              <dt class="text-slate-300">VUT activas ciudad</dt>
              <dd class="mt-1 font-mono text-xl font-extrabold text-white">
                {resumen.kpis.vutActivasValencia.toLocaleString("es-ES")}
              </dd>
              <span class="text-[11px] text-amber-300 font-mono">
                {resumen.kpis.plazasTuristicasValencia.toLocaleString("es-ES")} plazas
              </span>
            </div>

            <div class="rounded-xl bg-slate-950/70 p-3 border border-slate-800/80">
              <dt class="text-slate-300">Altas 2024–2026</dt>
              <dd class="mt-1 font-mono text-xl font-extrabold text-amber-400">
                +{resumen.kpis.altasRecientes2024a2026.toLocaleString("es-ES")}
              </dd>
              <span class="text-[11px] text-slate-300">
                50,7% del parque actual
              </span>
            </div>

            <div class="rounded-xl bg-slate-950/70 p-3 border border-slate-800/80">
              <dt class="text-slate-300">Alerta Crítica / Alta</dt>
              <dd class="mt-1 font-mono text-xl font-extrabold text-red-400">
                {resumen.kpis.barriosAlertaCriticaOAlta}{" "}
                <span class="text-xs font-normal text-slate-300">/ 88</span>
              </dd>
              <span class="text-[11px] text-slate-300">
                Barrios con ISVP ≥ 46
              </span>
            </div>

            <div class="rounded-xl bg-slate-950/70 p-3 border border-slate-800/80">
              <dt class="text-slate-300">Densidad media</dt>
              <dd class="mt-1 font-mono text-xl font-extrabold text-sky-300">
                {benchmarks.avgDensidadVutKm2}
              </dd>
              <span class="text-[11px] text-slate-300">
                VUT por km² barrial
              </span>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-7xl space-y-10 px-4 py-8 sm:px-6">
    <!-- TARJETAS KPI CON EXPLICACIÓN PEDAGÓGICA INTEGRADA -->
    <section aria-labelledby="heading-kpis" class="space-y-4">
      <div class="flex flex-wrap items-end justify-between gap-2">
        <div>
          <span class="text-xs font-bold tracking-wider text-sky-800 uppercase">
            Indicadores Clave de Ciudad · ¿Qué estamos midiendo?
          </span>
          <h2 id="heading-kpis" class="text-lg font-extrabold text-slate-900 sm:text-xl">
            Cuatro dimensiones para entender la presión barrial en València
          </h2>
        </div>
        <a
          href="/metodologia"
          class="text-xs font-bold text-sky-800 underline decoration-sky-300 underline-offset-2 hover:text-slate-950"
        >
          Ver explicación completa de las 12 métricas y fórmulas →
        </a>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <!-- KPI 1 -->
        <article class="interactive-card-hover flex flex-col justify-between rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs">
          <div>
            <div class="flex items-center justify-between gap-2">
              <span class="rounded-md bg-sky-100 px-2 py-0.5 text-[11px] font-bold text-sky-900">
                1. Presión Habitacional (35%)
              </span>
              <span class="font-mono text-[11px] font-semibold text-slate-600">
                GVA tur-gestur-vt
              </span>
            </div>
            <p class="mt-3 font-mono text-3xl font-extrabold text-slate-900">
              {resumen.kpis.vutActivasValencia.toLocaleString("es-ES")}{" "}
              <span class="text-sm font-semibold text-slate-600">VUT</span>
            </p>
            <p class="mt-1 text-xs font-semibold text-slate-800">
              {resumen.kpis.plazasTuristicasValencia.toLocaleString("es-ES")} plazas turísticas (
              <span class="text-amber-800">
                +{resumen.kpis.altasRecientes2024a2026.toLocaleString("es-ES")} desde 2024
              </span>
              )
            </p>
            <p class="mt-2.5 text-xs leading-relaxed text-slate-600">
              <strong>¿Qué significa?</strong> Cada piso turístico activo reduce el
              parque disponible de vivienda habitual. Medimos su densidad por km² y
              su ritmo de crecimiento reciente.
            </p>
          </div>
          <a
            href="/metodologia#presion_turistica"
            class="mt-3 inline-block text-xs font-bold text-sky-800 hover:underline"
          >
            Cómo se calcula la Presión Turística →
          </a>
        </article>

        <!-- KPI 2 -->
        <article class="interactive-card-hover flex flex-col justify-between rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs">
          <div>
            <div class="flex items-center justify-between gap-2">
              <span class="rounded-md bg-red-100 px-2 py-0.5 text-[11px] font-bold text-red-900">
                Índice Sintético ISVP (0–100)
              </span>
              <span class="font-mono text-[11px] font-semibold text-slate-600">
                88 Barrios
              </span>
            </div>
            <p class="mt-3 font-mono text-3xl font-extrabold text-red-700">
              {resumen.kpis.barriosAlertaCriticaOAlta}{" "}
              <span class="text-base font-normal text-slate-600">
                / {resumen.kpis.barriosAnalizados} barrios
              </span>
            </p>
            <p class="mt-1 text-xs font-semibold text-slate-800">
              {benchmarks.countsByAlert.Crítica} en Alerta Crítica y{" "}
              {benchmarks.countsByAlert.Alta} en Alerta Alta
            </p>
            <p class="mt-2.5 text-xs leading-relaxed text-slate-600">
              <strong>¿Qué significa?</strong> El ISVP combina de 0 a 100 los cuatro
              vectores del observatorio para identificar dónde coinciden saturación
              turística, pérdida comercial y fragilidad social.
            </p>
          </div>
          <a
            href="/metodologia#isvp"
            class="mt-3 inline-block text-xs font-bold text-sky-800 hover:underline"
          >
            Ver fórmula y umbrales del ISVP →
          </a>
        </article>

        <!-- KPI 3 -->
        <article class="interactive-card-hover flex flex-col justify-between rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs">
          <div>
            <div class="flex items-center justify-between gap-2">
              <span class="rounded-md bg-amber-100 px-2 py-0.5 text-[11px] font-bold text-amber-900">
                3. Convivencia y Espacio (20%)
              </span>
              <span class="font-mono text-[11px] font-semibold text-slate-600">
                FEMP Nº 11 y 20
              </span>
            </div>
            <p class="mt-3 font-mono text-3xl font-extrabold text-slate-900">
              {resumen.kpis.avisosCiudadanosAnalizados.toLocaleString("es-ES")}
            </p>
            <p class="mt-1 text-xs font-semibold text-slate-800">
              Quejas y comunicaciones vecinales clasificadas por barrio
            </p>
            <p class="mt-2.5 text-xs leading-relaxed text-slate-600">
              <strong>¿Qué significa?</strong> Cruzamos las quejas por ruido, ocio
              nocturno y limpieza con las licencias de terrazas e IAE para medir la
              saturación real del espacio público.
            </p>
          </div>
          <a
            href="/metodologia#brecha_equidad_urbana"
            class="mt-3 inline-block text-xs font-bold text-sky-800 hover:underline"
          >
            Cómo medimos Comercio y Convivencia →
          </a>
        </article>

        <!-- KPI 4 -->
        <article class="interactive-card-hover flex flex-col justify-between rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs">
          <div>
            <div class="flex items-center justify-between gap-2">
              <span class="rounded-md bg-emerald-100 px-2 py-0.5 text-[11px] font-bold text-emerald-900">
                4. Presupuesto y Equidad
              </span>
              <span class="font-mono text-[11px] font-semibold text-slate-600">
                FEMP Nº 12 y 40
              </span>
            </div>
            <p class="mt-3 font-mono text-3xl font-extrabold text-slate-900">
              {(resumen.kpis.gastoBienesServiciosEur / 1_000_000).toFixed(1)} M€
            </p>
            <p class="mt-1 text-xs font-semibold text-slate-800">
              Gasto corriente auditado ·{" "}
              {(resumen.kpis.subvencionesNominativasEur / 1_000_000).toFixed(1)} M€
              subvenciones
            </p>
            <p class="mt-2.5 text-xs leading-relaxed text-slate-600">
              <strong>¿Qué significa?</strong> Auditamos el presupuesto municipal y
              reclamamos su desagregación por código de barrio para verificar si la
              inversión compensa a los barrios más sobrecargados.
            </p>
          </div>
          <a
            href="/gobernanza"
            class="mt-3 inline-block text-xs font-bold text-sky-800 hover:underline"
          >
            Auditoría FEMP-80 y Ley 1/2022 →
          </a>
        </article>
      </div>
    </section>

    <!-- ESTACIÓN INTERACTIVA DE EXPLORACIÓN CARTOGRÁFICA Y RANKING DE LOS 88 BARRIOS -->
    <ObservatoryApp
      client:visible
      initialTopBarrios={resumen.topBarriosPresion.slice(0, 8)}
      initialAllBarrios={resumen.topBarriosPresion.slice(0, 12)}
      benchmarks={benchmarks}
      dataBaseUrl={dataBaseUrl}
    />

    <!-- ESCALA SEMAFÓRICA RÁPIDA Y ENLACES A LAS PÁGINAS DE PROFUNDIZACIÓN -->
    <section
      aria-labelledby="heading-escala-rapida"
      class="rounded-2xl border border-slate-200/90 bg-white p-6 shadow-xs"
    >
      <div class="flex flex-col gap-2 border-b border-slate-200 pb-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <span class="text-xs font-bold tracking-wider text-sky-800 uppercase">
            Guía Rápida de Interpretación Ciudadana
          </span>
          <h2 id="heading-escala-rapida" class="mt-1 text-lg font-extrabold text-slate-900 sm:text-xl">
            ¿Cómo interpretar los 4 niveles de alerta del índice ISVP?
          </h2>
        </div>
        <a
          href="/metodologia"
          class="text-xs font-bold text-sky-800 underline hover:text-slate-950"
        >
          Abrir manual metodológico completo →
        </a>
      </div>

      <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          ISVP_LEVELS.map((lvl) => (
            <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-4">
              <div class="flex items-center justify-between gap-2">
                <span
                  class={`inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-xs font-bold ${lvl.badgeClass}`}
                >
                  <span class={`h-2 w-2 rounded-full ${lvl.dotClass}`} aria-hidden="true" />
                  Alerta {lvl.level}
                </span>
                <span class="font-mono text-xs font-bold text-slate-700">
                  {lvl.range}
                </span>
              </div>
              <p class="mt-2.5 text-xs font-bold text-slate-900">
                {lvl.summary}
              </p>
              <p class="mt-1.5 text-xs leading-relaxed text-slate-600">
                {lvl.citizenMeaning}
              </p>
            </div>
          ))
        }
      </div>

      <!-- Tarjetas de navegación hacia las páginas especializadas del portal -->
      <div class="mt-6 grid gap-4 border-t border-slate-200 pt-6 md:grid-cols-3">
        <a
          href="/metodologia"
          class="interactive-card-hover group rounded-xl border border-slate-200 bg-slate-50 p-4 hover:border-sky-300 hover:bg-sky-50/40"
        >
          <span class="font-mono text-[11px] font-bold text-sky-800 uppercase">
            Página 2 · Guía Didáctica
          </span>
          <h3 class="mt-1 text-sm font-extrabold text-slate-900 group-hover:text-sky-900">
            Guía de Métricas, Fórmulas y Diccionario Ciudadano →
          </h3>
          <p class="mt-1 text-xs text-slate-600">
            Explicación paso a paso de cada indicador, cómo ponderamos códigos
            postales a barrios y preguntas frecuentes.
          </p>
        </a>

        <a
          href="/analisis"
          class="interactive-card-hover group rounded-xl border border-slate-200 bg-slate-50 p-4 hover:border-sky-300 hover:bg-sky-50/40"
        >
          <span class="font-mono text-[11px] font-bold text-amber-800 uppercase">
            Página 3 · Serie Longitudinal
          </span>
          <h3 class="mt-1 text-sm font-extrabold text-slate-900 group-hover:text-sky-900">
            Evolución 2015–2026, Distritos y Códigos Postales →
          </h3>
          <p class="mt-1 text-xs text-slate-600">
            Curva de aceleración de licencias VUT desde 2015, comparativa de los 19
            distritos y ranking de los 26 códigos postales.
          </p>
        </a>

        <a
          href="/gobernanza"
          class="interactive-card-hover group rounded-xl border border-slate-200 bg-slate-50 p-4 hover:border-sky-300 hover:bg-sky-50/40"
        >
          <span class="font-mono text-[11px] font-bold text-emerald-800 uppercase">
            Página 4 · Transparencia Activa
          </span>
          <h3 class="mt-1 text-sm font-extrabold text-slate-900 group-hover:text-sky-900">
            Auditoría FEMP-80, Solicitudes Ley 1/2022 y Descargas →
          </h3>
          <p class="mt-1 text-xs text-slate-600">
            Semáforo de calidad de datos municipales, generador de solicitudes de
            apertura y descarga de GeoJSON, Parquet y JSON.
          </p>
        </a>
      </div>
    </section>
  </div>
</PublicLayout>
