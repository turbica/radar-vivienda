---
import "../styles/global.css";
import fuentes from "../../../config/fuentes.json";
import BrandMark from "../components/BrandMark.astro";

type Section = "/" | "/barrios" | "/evolucion" | "/metodologia" | "/datos";

interface Props {
  title: string;
  description: string;
  currentPath: Section;
  /** Ruta canónica cuando difiere de la sección (p. ej. /barrios/russafa). */
  canonicalPath?: string;
  /** Miga de pan adicional tras la sección (p. ej. el nombre del barrio). */
  breadcrumbLeaf?: string;
  snapshotFile?: string;
  snapshotSha256?: string;
  updatedAt?: string;
  extraJsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description,
  currentPath,
  canonicalPath,
  breadcrumbLeaf,
  snapshotFile = "2026-10-18_tur-gestur-vt.csv",
  snapshotSha256 = "f074fb223a29ca60",
  updatedAt = new Date().toISOString(),
  extraJsonLd,
} = Astro.props;

const siteOrigin = "https://radar-vivienda.valencia.es";
const ownPath = canonicalPath ?? currentPath;
const canonicalUrl = `${siteOrigin}${ownPath}`;
const dataBaseUrl = (import.meta.env.PUBLIC_DATA_BASE_URL ?? "/data/processed").replace(
  /\/+$/,
  ""
);

const navItems: Array<{ href: Section; label: string }> = [
  { href: "/", label: "Inicio" },
  { href: "/barrios", label: "Barrios" },
  { href: "/evolucion", label: "Evolución" },
  { href: "/metodologia", label: "Método" },
  { href: "/datos", label: "Datos abiertos" },
];

const sectionName: Record<Section, string> = {
  "/": "Inicio",
  "/barrios": "Barrios",
  "/evolucion": "Evolución del registro turístico",
  "/metodologia": "Método del índice ISVP",
  "/datos": "Datos abiertos y solicitudes",
};

const breadcrumbItems = [
  { name: "Inicio", item: `${siteOrigin}/` },
  ...(currentPath !== "/"
    ? [{ name: sectionName[currentPath], item: `${siteOrigin}${currentPath}` }]
    : []),
  ...(breadcrumbLeaf ? [{ name: breadcrumbLeaf, item: canonicalUrl }] : []),
];

const baseJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Radar Vivienda València",
    alternateName:
      "Radar de Presión Residencial, Desplazamiento Comercial y Equidad de Barrio en València",
    url: siteOrigin,
    inLanguage: "es-ES",
    license: "https://www.gnu.org/licenses/agpl-3.0.html",
    description,
    publisher: {
      "@type": "Organization",
      name: "Radar Vivienda València",
      url: "https://github.com/turbica/radar-vivienda",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: "Serie longitudinal de viviendas turísticas, comercio local y vulnerabilidad por barrios en València",
    description:
      "Cruce semanal automatizado del registro de viviendas de uso turístico de la Generalitat Valenciana (tur-gestur-vt) con el catálogo CKAN del Ayuntamiento de València (censo IAE, terrazas, avisos FEMP 11, ayudas FEMP 12, facturas FEMP 40 y vulnerabilidad barrial) en los 88 barrios de València.",
    url: canonicalUrl,
    license: "https://www.gnu.org/licenses/agpl-3.0.html",
    isAccessibleForFree: true,
    creator: {
      "@type": "Organization",
      name: "Radar Vivienda València",
      url: "https://github.com/turbica/radar-vivienda",
    },
    spatialCoverage: { "@type": "Place", name: "València, Comunitat Valenciana, España" },
    temporalCoverage: "2015/2026",
    distribution: [
      {
        "@type": "DataDownload",
        encodingFormat: "application/geo+json",
        contentUrl: `${siteOrigin}${dataBaseUrl}/barrios_vulnerabilidad.geojson`,
      },
      {
        "@type": "DataDownload",
        encodingFormat: "application/json",
        contentUrl: `${siteOrigin}${dataBaseUrl}/resumen_observatorio.json`,
      },
      {
        "@type": "DataDownload",
        encodingFormat: "application/vnd.apache.parquet",
        contentUrl: `${siteOrigin}${dataBaseUrl}/viviendas_turisticas_valencia.parquet`,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbItems.map((b, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: b.name,
      item: b.item,
    })),
  },
  ...(Array.isArray(extraJsonLd) ? extraJsonLd : extraJsonLd ? [extraJsonLd] : []),
];

const formattedDate = new Date(updatedAt).toLocaleDateString("es-ES", {
  day: "numeric",
  month: "short",
  year: "numeric",
});
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#141414" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="mask-icon" href="/favicon.svg" color="#141414" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=IBM+Plex+Mono:wght@400;600&family=Public+Sans:wght@400;500;700&display=swap"
    />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Radar Vivienda València" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${siteOrigin}/og-cover.svg`} />
    <meta property="og:image:alt" content="Radar Vivienda València: presión residencial barrio a barrio" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteOrigin}/og-cover.svg`} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(baseJsonLd)} />
  </head>
  <body class="min-h-screen antialiased">
    <a href="#main-content" class="skip-link">Saltar al contenido principal</a>

    <header class="border-b-[3px] border-ink">
      <div class="mx-auto flex max-w-[1320px] flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-4 sm:px-6">
        <a href="/" class="flex items-center gap-3 text-ink no-underline">
          <BrandMark size={36} />
          <span class="leading-none">
            <span class="font-display block text-[22px] font-extrabold">Radar Vivienda</span>
            <span class="mt-1 block font-mono text-[11px] tracking-[0.12em] uppercase">València</span>
          </span>
        </a>

        <nav
          aria-label="Principal"
          class="order-3 -mx-4 flex w-[calc(100%+2rem)] gap-1 overflow-x-auto px-4 sm:mx-0 sm:w-auto sm:px-0 lg:order-none"
        >
          {
            navItems.map((item) => {
              const isActive = currentPath === item.href;
              return (
                <a
                  href={item.href}
                  aria-current={isActive ? "page" : undefined}
                  class={`shrink-0 px-3.5 py-2.5 text-[15px] no-underline ${
                    isActive ? "bg-ink font-bold text-paper" : "font-medium text-ink hover:bg-ink/8"
                  }`}
                >
                  {item.label}
                </a>
              );
            })
          }
        </nav>

        <p
          class="font-mono text-[13px]"
          title={`Archivo fuente: ${snapshotFile} · SHA-256: ${snapshotSha256}`}
        >
          Instantánea · <time datetime={updatedAt}>{formattedDate}</time>
        </p>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="bg-ink text-paper">
      <div class="mx-auto grid max-w-[1320px] gap-10 px-4 py-12 sm:px-6 md:grid-cols-12">
        <div class="space-y-3 md:col-span-5">
          <p class="font-display text-2xl font-extrabold">Radar Vivienda València</p>
          <p class="max-w-md text-sm leading-relaxed text-paper/80">
            Observatorio ciudadano de turistificación, comercio de barrio y equidad urbana. Cada
            semana guardamos el registro de viviendas turísticas de la Generalitat para construir el
            histórico que no existe en origen.
          </p>
          <p class="text-sm">
            Código bajo <a class="text-paper underline" href="https://github.com/turbica/radar-vivienda">AGPL-3.0</a>
            · Conector CKAN:{" "}
            <a class="text-paper underline" href="https://github.com/turbica/valencia-open-data-core">
              valencia-open-data-core
            </a>
          </p>
        </div>

        <nav aria-label="Secciones" class="md:col-span-3">
          <p class="font-mono text-xs tracking-[0.12em] uppercase">Secciones</p>
          <ul class="mt-3 space-y-2 text-sm">
            {
              navItems.map((item) => (
                <li>
                  <a href={item.href} class="text-paper underline-offset-2 hover:underline">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="md:col-span-4">
          <p class="font-mono text-xs tracking-[0.12em] uppercase">Fuentes</p>
          <ul class="mt-3 space-y-2 text-sm">
            <li>
              <a href={fuentes.gva_viviendas_turisticas_ficha} class="text-paper underline-offset-2 hover:underline">
                GVA Dades Obertes — viviendas turísticas (CC BY)
              </a>
            </li>
            <li>
              <a href={fuentes.valencia_ckan_portal} class="text-paper underline-offset-2 hover:underline">
                Portal de datos abiertos del Ayuntamiento de València
              </a>
            </li>
            <li>
              <a href={fuentes.oficina_estadistica_valencia.web} class="text-paper underline-offset-2 hover:underline">
                Oficina de Estadística de València
              </a>
            </li>
          </ul>
        </div>

        <p class="border-t border-paper/25 pt-6 font-mono text-xs text-paper/80 md:col-span-12">
          {snapshotFile} · sha256 {snapshotSha256.slice(0, 8)}…{snapshotSha256.slice(-5)}
        </p>
      </div>
    </footer>
  </body>
</html>
