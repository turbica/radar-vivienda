---
import PublicLayout from "../layouts/PublicLayout.astro";
import { loadObservatoryData } from "../lib/data";
import { NIVEL_COLOR } from "../lib/barrios";
import {
  CORE_VECTORS_GUIDE,
  EMPIRICAL_METRICS_GLOSSARY,
  ISVP_LEVELS,
} from "../lib/metrics-catalog";

const { resumen } = await loadObservatoryData();

const pageTitle = "Método del índice ISVP — Radar Vivienda València";
const pageDescription =
  "Qué significa cada indicador del observatorio: cómo se calcula el Índice Sintético de Vulnerabilidad y Presión (ISVP), de dónde salen los datos y cómo interpretarlos.";

const faqItems = [
  {
    question: "¿Qué es el índice ISVP y cómo debo leer una puntuación de 0 a 100?",
    answer:
      "El Índice Sintético de Vulnerabilidad y Presión (ISVP) resume en una escala de 0 a 100 la tensión acumulada en un barrio de València. Combina cuatro dimensiones: presión de viviendas turísticas (35%), riesgo de desplazamiento comercial y terrazas (25%), quejas vecinales de convivencia y mantenimiento urbano (20%) y vulnerabilidad socioeconómica de los residentes (20%). Un valor inferior a 32 indica presión baja; entre 32 y 45,9 moderada; entre 46 y 61,9 alerta alta; y a partir de 62 alerta crítica.",
  },
  {
    question: "¿Por qué no basta con mirar el número total de pisos turísticos de un barrio?",
    answer:
      "Porque los 88 barrios de València tienen superficies, densidades residenciales y niveles de renta muy diferentes. Un barrio muy extenso puede tener 100 viviendas turísticas con baja afectación por kilómetro cuadrado, mientras que un barrio histórico compacto o con población envejecida y de menor renta sufre un impacto mucho más severo ante la misma cifra. Por eso normalizamos por superficie (VUT/km²) y cruzamos con comercio local y vulnerabilidad social.",
  },
  {
    question: "¿De dónde salen los datos y cada cuánto tiempo se actualizan?",
    answer:
      "Todos los datos provienen de fuentes públicas oficiales: el Registro de Viviendas de Uso Turístico de la Generalitat Valenciana (dataset tur-gestur-vt en Dades Obertes GVA) y el portal CKAN de Datos Abiertos del Ayuntamiento de València (cartografía de barrios, vulnerabilidad municipal y los conjuntos FEMP n.º 11 de quejas y sugerencias, n.º 12 de subvenciones, n.º 20 de censo IAE y terrazas, y n.º 40 de ejecución presupuestaria). Los colectores automatizados comprueban y archivan nuevas instantáneas semanalmente.",
  },
  {
    question: "¿Cómo se asignan los pisos turísticos de la Generalitat a cada uno de los 88 barrios?",
    answer:
      "El censo autonómico de la GVA publica la dirección y el código postal (46001 a 46026) de cada vivienda turística, pero no incluye el código normalizado de barrio municipal (coddistbar). El motor analítico del observatorio utiliza una matriz de intersección espacial validada entre códigos postales y los 88 polígonos oficiales de barris-barrios (donde los pesos de cada código postal suman exactamente 1,00), al tiempo que el proyecto solicita formalmente a la Generalitat y al Ayuntamiento la publicación directa del código censal/barrial.",
  },
  {
    question: "¿Por qué el observatorio guarda copias semanales del archivo de la GVA?",
    answer:
      "La Generalitat Valenciana sobrescribe periódicamente su archivo CSV de viviendas turísticas vigentes sin conservar un histórico público de altas y bajas. Nuestro colector descarga cada semana una instantánea fechada e inmutable con firma criptográfica SHA-256 y ejecuta consultas diferenciales SQL (EXCEPT) en DuckDB para detectar exactamente qué signaturas turísticas se dan de alta o de baja a lo largo del tiempo.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};

const indice = [
  { href: "#niveles", label: "Los cuatro niveles" },
  { href: "#vectores", label: "Los cuatro vectores" },
  { href: "#glosario", label: "Glosario" },
  { href: "#proceso", label: "Proceso de datos" },
  { href: "#preguntas", label: "Preguntas" },
];

const pasos = [
  {
    titulo: "Captura inmutable",
    texto:
      "Cada semana guardamos el CSV oficial de la GVA (tur-gestur-vt) y los datasets municipales con la fecha en el nombre y su huella SHA-256. Nunca se sobrescribe un archivo.",
  },
  {
    titulo: "Altas y bajas con DuckDB",
    texto:
      "Comparamos cada instantánea con la anterior para saber qué licencias han entrado en el registro y cuáles han salido.",
  },
  {
    titulo: "Del código postal al barrio",
    texto:
      "El registro de la GVA solo trae código postal. Lo repartimos entre los barrios con pesos espaciales que suman exactamente 1,00 en cada código postal.",
  },
];
---

<PublicLayout
  title={pageTitle}
  description={pageDescription}
  currentPath="/metodologia"
  snapshotFile={resumen.latestSnapshot.fileName}
  snapshotSha256={resumen.latestSnapshot.sha256}
  updatedAt={resumen.updatedAt}
  extraJsonLd={faqJsonLd}
>
  <div class="mx-auto max-w-[1320px] px-4 sm:px-6">
    <section class="border-b border-ink pt-12 pb-10">
      <p class="mb-3 font-mono text-[13px] tracking-[0.08em] uppercase">Método</p>
      <h1 class="font-display max-w-[18ch] text-[clamp(44px,6vw,80px)] leading-[0.95] font-extrabold tracking-[-0.035em]">
        Cómo se calcula la <span class="mark">nota de cada barrio</span>
      </h1>
      <p class="mt-6 max-w-2xl text-[19px] leading-relaxed">
        Qué mide cada indicador, de qué fuente oficial sale, cómo se combina en el índice ISVP de 0 a 100 y
        qué significa cada nivel para la vida del vecindario.
      </p>
      <nav aria-label="En esta página" class="mt-8 flex flex-wrap gap-2">
        {indice.map((i) => <a href={i.href} class="btn btn-line min-h-[44px] text-[15px]">{i.label}</a>)}
      </nav>
    </section>

    <section id="niveles" aria-labelledby="h-niveles" class="border-b border-ink py-12">
      <h2 id="h-niveles" class="font-display mb-2 text-[32px] font-extrabold">Los cuatro niveles</h2>
      <p class="mb-8 max-w-3xl font-mono text-sm leading-relaxed">
        ISVP = 0,35 × presión turística + 0,25 × desplazamiento comercial + 0,20 × brecha de equidad urbana
        + 0,20 × vulnerabilidad residencial
      </p>
      <div class="grid gap-px border-y-2 border-ink bg-ink sm:grid-cols-2 lg:grid-cols-4">
        {
          ISVP_LEVELS.map((lvl) => (
            <div class="bg-paper p-6">
              <div class="flex items-center justify-between gap-2">
                <span class="flex items-center gap-2 font-bold">
                  <span
                    aria-hidden="true"
                    class="h-4 w-4 rounded-full border border-ink"
                    style={{ backgroundColor: NIVEL_COLOR[lvl.level] }}
                  />
                  {lvl.level}
                </span>
                <span class="font-mono text-xs">{lvl.range}</span>
              </div>
              <p class="mt-3 leading-snug font-bold">{lvl.summary}</p>
              <p class="mt-2 text-sm leading-relaxed">{lvl.citizenMeaning}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section id="vectores" aria-labelledby="h-vectores" class="border-b border-ink py-12">
      <h2 id="h-vectores" class="font-display mb-8 text-[32px] font-extrabold">Los cuatro vectores</h2>
      <div class="space-y-12">
        {
          CORE_VECTORS_GUIDE.filter((v) => v.id !== "isvp").map((v) => (
            <article class="grid gap-8 border-t-[6px] border-ink pt-6 lg:grid-cols-12">
              <div class="lg:col-span-4">
                <p class="font-display text-[40px] font-extrabold">{v.weightInIsvp}</p>
                <h3 class="font-display mt-1 text-2xl font-extrabold">{v.shortTitle}</h3>
                <p class="mt-3 font-mono text-xs leading-relaxed">
                  {v.sourceName}
                  <br />
                  {v.sourceDatasetId}
                </p>
              </div>
              <div class="space-y-4 leading-relaxed lg:col-span-5">
                <p>{v.plainExplanation}</p>
                <p>
                  <strong>Por qué importa.</strong> {v.whyItMatters}
                </p>
                <p class="bg-paper-2 p-4 font-mono text-sm">{v.formulaSummary}</p>
              </div>
              <ul class="space-y-3 lg:col-span-3">
                {v.interpretationGuide.map((step) => (
                  <li class="border-b border-ink/30 pb-3">
                    <p class="flex justify-between gap-3 text-sm font-bold">
                      <span>{step.label}</span>
                      <span class="font-mono font-normal">{step.range}</span>
                    </p>
                    <p class="mt-1 text-sm">{step.meaning}</p>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section id="glosario" aria-labelledby="h-glosario" class="border-b border-ink py-12">
      <h2 id="h-glosario" class="font-display mb-8 text-[32px] font-extrabold">Glosario de variables</h2>
      <dl class="grid gap-x-10 gap-y-8 md:grid-cols-2">
        {
          EMPIRICAL_METRICS_GLOSSARY.map((item) => (
            <div class="border-t-2 border-ink pt-4">
              <dt>
                <span class="block font-mono text-xs uppercase">
                  {item.category} · {item.unit}
                </span>
                <span class="font-display mt-1 block text-xl font-extrabold">{item.name}</span>
              </dt>
              <dd class="mt-2 space-y-2 text-[15px] leading-relaxed">
                <p>{item.whatIsIt}</p>
                <p>
                  <strong>Cómo leerlo.</strong> {item.howToReadIt}
                </p>
                <p class="font-mono text-xs text-muted">Fuente: {item.source}</p>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section id="proceso" aria-labelledby="h-proceso" class="border-b border-ink py-12">
      <h2 id="h-proceso" class="font-display mb-8 text-[32px] font-extrabold">Proceso de datos</h2>
      <ol class="grid gap-8 md:grid-cols-3">
        {
          pasos.map((p, i) => (
            <li class="border-t-[6px] border-ink pt-4">
              <p class="font-mono text-xs uppercase">Paso {i + 1}</p>
              <h3 class="font-display mt-1 text-xl font-extrabold">{p.titulo}</h3>
              <p class="mt-2 leading-relaxed">{p.texto}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="preguntas" aria-labelledby="h-preguntas" class="flex flex-wrap gap-10 py-12 pb-16">
      <h2 id="h-preguntas" class="font-display flex-[1_1_260px] text-[32px] font-extrabold">
        Preguntas frecuentes
      </h2>
      <div class="min-w-0 flex-[2_1_560px] border-t-2 border-ink">
        {
          faqItems.map((faq) => (
            <details class="group border-b border-ink py-5">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-lg font-bold">
                {faq.question}
                <span aria-hidden="true" class="font-mono text-xl transition-transform group-open:rotate-45">
                  +
                </span>
              </summary>
              <p class="mt-3 max-w-3xl leading-relaxed">{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </section>
  </div>
</PublicLayout>
