---
import "../styles/global.css";
import { RadarMap } from "../components/RadarMap";
import fuentes from "../../../config/fuentes.json";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Radar Vivienda València — Observatorio de Presión Residencial y Equidad de Barrio</title>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
        <div>
          <span class="inline-block rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-medium text-amber-800">
            Observatorio Vivo · València
          </span>
          <h1 class="mt-1 text-xl font-bold tracking-tight text-slate-900">
            Radar de Presión Residencial, Desplazamiento Comercial y Equidad de Barrio
          </h1>
        </div>
        <a
          href="https://github.com/turbica/radar-vivienda"
          target="_blank"
          rel="noreferrer"
          class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-100"
        >
          AGPL-3.0 · GitHub
        </a>
      </div>
    </header>

    <main class="mx-auto max-w-6xl space-y-8 px-6 py-8">
      <section class="grid gap-4 sm:grid-cols-3">
        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-xs">
          <p class="text-xs font-semibold tracking-wider text-slate-500 uppercase">Dataset Principal GVA</p>
          <p class="mt-2 text-2xl font-bold text-slate-900">{fuentes.gva_viviendas_turisticas_dataset_id}</p>
          <p class="mt-1 text-xs text-slate-600">Captura diferencial semanal de licencias turísticas vigentes</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-xs">
          <p class="text-xs font-semibold tracking-wider text-slate-500 uppercase">Cruces FEMP 80 (CKAN Municipal)</p>
          <p class="mt-2 text-2xl font-bold text-slate-900">{fuentes.datasets_municipales_femp80.length} series</p>
          <p class="mt-1 text-xs text-slate-600">Avisos (11), Ayudas (12), Censo empresarial (20) y Facturas (40)</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-xs">
          <p class="text-xs font-semibold tracking-wider text-slate-500 uppercase">Frecuencia de Ingesta</p>
          <p class="mt-2 text-2xl font-bold text-slate-900">Semanal / Mensual</p>
          <p class="mt-1 text-xs text-slate-600">Histórico abierto publicado en GitHub Releases</p>
        </div>
      </section>

      <section class="space-y-3">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-semibold text-slate-900">Cartografía de Presión Turística y Vulnerabilidad Barrial</h2>
          <span class="text-xs text-slate-500">MapLibre GL JS · Teselas Vectoriales PBF</span>
        </div>
        <RadarMap client:only="react" />
      </section>
    </main>
  </body>
</html>
