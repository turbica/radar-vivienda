---
import PublicLayout from "../layouts/PublicLayout.astro";
import AnnualBars from "../components/AnnualBars.astro";
import LevelLegend from "../components/LevelLegend.astro";
import { BarrioSearch } from "../components/BarrioSearch";
import { PressureMap } from "../components/PressureMap";
import { loadObservatoryData } from "../lib/data";
import { fmtNum, nombreLegible, rankingIsvp, slugBarrio, toBusqueda } from "../lib/barrios";

const { resumen, series, benchmarks, dataBaseUrl } = await loadObservatoryData();
const baseUrl = dataBaseUrl.replace(/\/+$/, "");
const { kpis } = resumen;

const ranking = rankingIsvp(resumen.allBarrios);
const top10 = ranking.slice(0, 10);
const busqueda = toBusqueda(resumen.allBarrios);
const destacados = ranking.slice(0, 4).map((b) => slugBarrio(b.nombre));

const anioCaptura = new Date(resumen.latestSnapshot.capturedAt).getFullYear();
const serie = series.serieAnualAltas.map((r) => ({ anio: r.anio, valor: r.nuevas_licencias }));
const fechaCorte = new Date(resumen.latestSnapshot.lastModified ?? resumen.latestSnapshot.capturedAt)
  .toLocaleDateString("es-ES", { day: "numeric", month: "short" });

const vectores = [
  { peso: "35 %", nombre: "Presión turística", texto: "Licencias por km², plazas y velocidad de nuevas altas." },
  { peso: "25 %", nombre: "Desplazamiento comercial", texto: "Cambio en actividades económicas (IAE) y terrazas." },
  { peso: "20 %", nombre: "Brecha de equidad", texto: "Avisos de deterioro frente al gasto en mantenimiento." },
  { peso: "20 %", nombre: "Vulnerabilidad residencial", texto: "Fragilidad social y demográfica del vecindario." },
];

const cifras = [
  { valor: kpis.plazasTuristicasValencia, texto: "plazas turísticas en la ciudad" },
  { valor: kpis.altasRecientes2024a2026, texto: "altas nuevas entre 2024 y 2026" },
  { valor: kpis.avisosCiudadanosAnalizados, texto: "avisos ciudadanos analizados" },
  { valor: kpis.vutActivasComunitat, texto: "pisos turísticos en la Comunitat" },
];

const pageTitle = "Radar Vivienda València — Presión residencial barrio a barrio";
const pageDescription = `${fmtNum(kpis.vutActivasValencia)} viviendas turísticas y ${kpis.barriosAlertaCriticaOAlta} barrios en alerta. Observatorio semanal de turistificación, comercio de barrio y equidad urbana en los 88 barrios de València.`;
---

<PublicLayout
  title={pageTitle}
  description={pageDescription}
  currentPath="/"
  snapshotFile={resumen.latestSnapshot.fileName}
  snapshotSha256={resumen.latestSnapshot.sha256}
  updatedAt={resumen.updatedAt}
>
  <div class="mx-auto max-w-[1320px] px-4 sm:px-6">
    <section class="border-b border-ink pt-12 pb-10 sm:pt-14">
      <p class="mb-4 font-mono text-[13px] tracking-[0.08em] uppercase">
        Edición semanal · nº {kpis.snapshotsAcumulados} · València
      </p>
      <h1 class="font-display max-w-[16ch] text-[clamp(44px,7vw,96px)] leading-[0.95] font-extrabold tracking-[-0.035em]">
        {fmtNum(kpis.vutActivasValencia)} pisos turísticos.{" "}
        <span class="mark">{kpis.barriosAlertaCriticaOAlta} barrios</span> en alerta.
      </h1>
      <div class="mt-10 grid items-start gap-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
        <p class="max-w-xl text-[19px] leading-relaxed">
          Cada semana descargamos el registro de viviendas turísticas de la Generalitat y lo cruzamos
          con comercio, avisos vecinales y gasto municipal. La GVA no guarda histórico: esta serie la
          construimos nosotros.
        </p>
        <div>
          <h2 class="font-display mb-3 text-2xl font-extrabold">¿Cómo está tu barrio?</h2>
          <BarrioSearch
            client:load
            barrios={busqueda}
            destacados={destacados}
            destacadosLabel="Los más tensionados:"
          />
        </div>
      </div>
    </section>

    <section aria-labelledby="h-mapa" class="flex flex-wrap gap-10 border-b border-ink py-10">
      <div class="min-w-0 flex-[999_1_560px]">
        <div class="mb-4 flex flex-wrap items-baseline justify-between gap-3">
          <h2 id="h-mapa" class="font-display text-[32px] font-extrabold">El mapa de la presión</h2>
          <span class="font-mono text-[13px]">ISVP 0–100 · clic en un barrio para abrir su ficha</span>
        </div>
        <PressureMap client:visible geojsonUrl={`${baseUrl}/barrios_vulnerabilidad.geojson`} />
        <div class="mt-4">
          <LevelLegend counts={benchmarks.countsByAlert} />
        </div>
      </div>

      <div class="min-w-0 flex-[1_1_340px]">
        <h2 class="font-display mb-4 text-[32px] font-extrabold">Los 10 más tensionados</h2>
        <ol class="border-t-2 border-ink">
          {
            top10.map((b, i) => (
              <li class="border-b border-ink">
                <a
                  href={`/barrios/${slugBarrio(b.nombre)}`}
                  class="link-row grid grid-cols-[32px_1fr_auto] items-center gap-3 py-3 text-ink no-underline"
                >
                  <span class="font-mono text-[13px]">{String(i + 1).padStart(2, "0")}</span>
                  <span class="flex flex-col">
                    <span class="link-row-name text-[17px] font-bold">{nombreLegible(b.nombre)}</span>
                    <span class="text-[13px] text-muted">{b.distrito}</span>
                  </span>
                  <span class="font-display text-[26px] font-extrabold">{fmtNum(b.isvp, 1)}</span>
                </a>
              </li>
            ))
          }
        </ol>
        <a href="/barrios" class="mt-4 inline-block font-bold text-ink">Ver los {resumen.allBarrios.length} barrios →</a>
      </div>
    </section>

    <section aria-label="Cifras clave" class="grid gap-px border-b border-ink bg-ink sm:grid-cols-2 lg:grid-cols-4">
      {
        cifras.map((c) => (
          <div class="bg-paper py-7 sm:px-6 sm:first:pl-0">
            <p class="font-display text-5xl font-extrabold tracking-[-0.03em]">{fmtNum(c.valor)}</p>
            <p class="mt-1 text-[15px]">{c.texto}</p>
          </div>
        ))
      }
    </section>

    <section aria-labelledby="h-serie" class="border-b border-ink py-12">
      <div class="mb-6 flex flex-wrap items-baseline justify-between gap-3">
        <h2 id="h-serie" class="font-display text-[32px] font-extrabold">Licencias vigentes por año de alta</h2>
        <span class="font-mono text-[13px]">*{anioCaptura} hasta el {fechaCorte}</span>
      </div>
      <AnnualBars
        rows={serie}
        resaltarDesde={2024}
        anioParcial={anioCaptura}
        label={`Altas anuales de licencias aún vigentes entre ${serie[0]?.anio} y ${anioCaptura}`}
      />
      <p class="mt-4 text-sm text-muted">
        Solo cuenta licencias que siguen vigentes hoy. <a href="/evolucion" class="font-bold text-ink">Ver la evolución completa →</a>
      </p>
    </section>

    <section aria-labelledby="h-indice" class="grid gap-8 py-12 sm:grid-cols-2 lg:grid-cols-5">
      <div>
        <h2 id="h-indice" class="font-display mb-3 text-[32px] font-extrabold">Qué mide el índice</h2>
        <p class="mb-4 leading-relaxed">
          El ISVP suma cuatro vectores con pesos fijos. Contar pisos no basta: 200 licencias pesan más
          en un barrio pequeño y envejecido.
        </p>
        <a href="/metodologia" class="font-bold text-ink">Leer el método →</a>
      </div>
      {
        vectores.map((v) => (
          <div class="border-t-[6px] border-ink pt-4">
            <p class="font-display text-[40px] font-extrabold">{v.peso}</p>
            <p class="mt-1 mb-1.5 text-[17px] font-bold">{v.nombre}</p>
            <p class="text-sm leading-normal">{v.texto}</p>
          </div>
        ))
      }
    </section>
  </div>
</PublicLayout>
