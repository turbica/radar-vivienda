---
import PublicLayout from "../layouts/PublicLayout.astro";
import { loadObservatoryData } from "../lib/data";
import {
  CORE_VECTORS_GUIDE,
  EMPIRICAL_METRICS_GLOSSARY,
  ISVP_LEVELS,
} from "../lib/metrics-catalog";

const { resumen, benchmarks } = await loadObservatoryData();

const pageTitle =
  "Guía Ciudadana de Métricas y Metodología ISVP — Radar Vivienda València";
const pageDescription =
  "Aprende qué significa cada indicador del observatorio: cómo se calcula el Índice Sintético de Vulnerabilidad y Presión (ISVP), de dónde salen los datos y cómo interpretarlos.";

const faqItems = [
  {
    question: "¿Qué es el índice ISVP y cómo debo leer una puntuación de 0 a 100?",
    answer:
      "El Índice Sintético de Vulnerabilidad y Presión (ISVP) resume en una escala de 0 a 100 la tensión acumulada en un barrio de València. Combina cuatro dimensiones: presión de viviendas turísticas (35%), riesgo de desplazamiento comercial y terrazas (25%), quejas vecinales de convivencia y mantenimiento urbano (20%) y vulnerabilidad socioeconómica de los residentes (20%). Un valor inferior a 32 indica presión baja; entre 32 y 45,9 moderada; entre 46 y 61,9 alerta alta; y a partir de 62 alerta crítica.",
  },
  {
    question: "¿Por qué no basta con mirar el número total de pisos turísticos de un barrio?",
    answer:
      "Porque los 88 barrios de València tienen superficies, densidades residenciales y niveles de renta muy diferentes. Un barrio muy extenso puede tener 100 viviendas turísticas con baja afectación por kilómetro cuadrado, mientras que un barrio histórico compacto o con población envejecida y de menor renta sufre un impacto mucho más severo ante la misma cifra. Por eso normalizamos por superficie (VUT/km²) y cruzamos con comercio local y vulnerabilidad social.",
  },
  {
    question: "¿De dónde salen los datos y cada cuánto tiempo se actualizan?",
    answer:
      "Todos los datos provienen de fuentes públicas oficiales: el Registro de Viviendas de Uso Turístico de la Generalitat Valenciana (dataset tur-gestur-vt en Dades Obertes GVA) y el portal CKAN de Datos Abiertos del Ayuntamiento de València (cartografía de barrios, vulnerabilidad municipal y los conjuntos FEMP n.º 11 de quejas y sugerencias, n.º 12 de subvenciones, n.º 20 de censo IAE y terrazas, y n.º 40 de ejecución presupuestaria). Los colectores automatizados comprueban y archivan nuevas instantáneas semanalmente.",
  },
  {
    question: "¿Cómo se asignan los pisos turísticos de la Generalitat a cada uno de los 88 barrios?",
    answer:
      "El censo autonómico de la GVA publica la dirección y el código postal (46001 a 46026) de cada vivienda turística, pero no incluye el código normalizado de barrio municipal (coddistbar). El motor analítico del observatorio utiliza una matriz de intersección espacial validada entre códigos postales y los 88 polígonos oficiales de barris-barrios (donde los pesos de cada código postal suman exactamente 1,00), al tiempo que el proyecto solicita formalmente a la Generalitat y al Ayuntamiento la publicación directa del código censal/barrial.",
  },
  {
    question: "¿Por qué el observatorio guarda copias semanales del archivo de la GVA?",
    answer:
      "La Generalitat Valenciana sobrescribe periódicamente su archivo CSV de viviendas turísticas vigentes sin conservar un histórico público de altas y bajas. Nuestro colector descarga cada semana una instantánea fechada e inmutable con firma criptográfica SHA-256 y ejecuta consultas diferenciales SQL (EXCEPT) en DuckDB para detectar exactamente qué signaturas turísticas se dan de alta o de baja a lo largo del tiempo.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
---

<PublicLayout
  title={pageTitle}
  description={pageDescription}
  currentPath="/metodologia"
  snapshotFile={resumen.latestSnapshot.fileName}
  snapshotSha256={resumen.latestSnapshot.sha256}
  updatedAt={resumen.updatedAt}
  extraJsonLd={faqJsonLd}
>
  <!-- Cabecera de la Guía Ciudadana -->
  <section class="civic-grid-bg border-b border-slate-800 text-white">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:py-12">
      <div class="max-w-3xl space-y-4">
        <div class="flex flex-wrap items-center gap-2">
          <span class="rounded-full bg-sky-500/20 px-3 py-1 text-xs font-bold text-sky-300 ring-1 ring-sky-400/30">
            Manual Didáctico y Metodológico
          </span>
          <span class="rounded-full bg-slate-800 px-3 py-1 font-mono text-xs font-semibold text-slate-300">
            Lectura clara para ciudadanía, prensa e investigación
          </span>
        </div>

        <h1 class="text-2xl font-extrabold tracking-tight text-white sm:text-4xl">
          ¿Qué estás viendo en el Observatorio? Guía Ciudadana de Métricas y Fórmulas
        </h1>

        <p class="text-sm leading-relaxed text-slate-300 sm:text-base">
          Esta página explica en lenguaje sencillo qué mide cada indicador del
          <strong>Radar Vivienda València</strong>, de qué fuente oficial procede,
          cómo se calcula la puntuación de <strong>0 a 100</strong> de cada barrio
          y qué significan los niveles de alerta para la vida cotidiana del vecindario.
        </p>

        <!-- Índice rápido de salto en móvil y escritorio -->
        <div class="flex flex-wrap gap-2 pt-2">
          <a
            href="#formula-isvp"
            class="interactive-btn rounded-xl bg-sky-500 px-3.5 py-2 text-xs font-extrabold text-slate-950 hover:bg-sky-400"
          >
            1. El Índice ISVP y Niveles de Alerta
          </a>
          <a
            href="#vectores-explicados"
            class="interactive-btn rounded-xl border border-slate-700 bg-slate-900 px-3.5 py-2 text-xs font-bold text-slate-100 hover:bg-slate-800"
          >
            2. Las 5 Capas del Mapa
          </a>
          <a
            href="#glosario-metricas"
            class="interactive-btn rounded-xl border border-slate-700 bg-slate-900 px-3.5 py-2 text-xs font-bold text-slate-100 hover:bg-slate-800"
          >
            3. Diccionario de las 10 Variables
          </a>
          <a
            href="#arquitectura-datos"
            class="interactive-btn rounded-xl border border-slate-700 bg-slate-900 px-3.5 py-2 text-xs font-bold text-slate-100 hover:bg-slate-800"
          >
            4. Cruce Espacial y DuckDB
          </a>
          <a
            href="#preguntas-frecuentes"
            class="interactive-btn rounded-xl border border-slate-700 bg-slate-900 px-3.5 py-2 text-xs font-bold text-slate-100 hover:bg-slate-800"
          >
            5. Preguntas Frecuentes
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
    <div class="grid gap-10 lg:grid-cols-12">
      <!-- Barra lateral de navegación fija en escritorio -->
      <aside class="hidden lg:col-span-3 lg:block">
        <div class="sticky top-24 space-y-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-xs">
          <div>
            <h2 class="text-xs font-bold tracking-wider text-slate-900 uppercase">
              Índice de la Guía
            </h2>
            <nav aria-label="Índice de contenidos de metodología" class="mt-3 space-y-1.5 text-xs">
              <a
                href="#formula-isvp"
                class="block rounded-lg px-2.5 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 hover:text-slate-950"
              >
                1. ¿Qué es el ISVP (0–100)?
              </a>
              <a
                href="#vectores-explicados"
                class="block rounded-lg px-2.5 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 hover:text-slate-950"
              >
                2. Los 4 Vectores en detalle
              </a>
              <div class="space-y-1 pl-3 border-l border-slate-200 ml-2">
                {
                  CORE_VECTORS_GUIDE.map((v) => (
                    <a
                      href={`#${v.id}`}
                      class="block py-1 text-[11px] font-medium text-slate-600 hover:text-sky-800"
                    >
                      · {v.shortTitle}
                    </a>
                  ))
                }
              </div>
              <a
                href="#glosario-metricas"
                class="block rounded-lg px-2.5 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 hover:text-slate-950"
              >
                3. Diccionario de Variables
              </a>
              <a
                href="#arquitectura-datos"
                class="block rounded-lg px-2.5 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 hover:text-slate-950"
              >
                4. Método Espacial (CP → Barrio)
              </a>
              <a
                href="#preguntas-frecuentes"
                class="block rounded-lg px-2.5 py-1.5 font-semibold text-slate-700 hover:bg-slate-100 hover:text-slate-950"
              >
                5. Preguntas Frecuentes (FAQ)
              </a>
            </nav>
          </div>

          <div class="rounded-xl border border-sky-200 bg-sky-50/70 p-3.5 text-xs">
            <p class="font-bold text-sky-950">¿Quieres ver tu barrio ahora?</p>
            <p class="mt-1 text-slate-700">
              Vuelve al mapa interactivo para consultar la ficha de cualquiera de los
              88 barrios de València.
            </p>
            <a
              href="/"
              class="interactive-btn mt-3 inline-flex w-full items-center justify-center rounded-lg bg-slate-900 px-3 py-2 font-bold text-white hover:bg-slate-800"
            >
              Ir al Mapa Interactivo
            </a>
          </div>
        </div>
      </aside>

      <!-- Cuerpo principal explicativo -->
      <div class="space-y-12 lg:col-span-9">
        <!-- SECCIÓN 1: EL ÍNDICE SINTÉTICO ISVP Y SU FÓRMULA -->
        <section
          id="formula-isvp"
          aria-labelledby="heading-formula-isvp"
          class="scroll-mt-24 rounded-2xl border border-slate-200 bg-white p-6 shadow-xs sm:p-8"
        >
          <span class="text-xs font-bold tracking-wider text-sky-800 uppercase">
            Sección 1 · La Métrica Principal del Observatorio
          </span>
          <h2
            id="heading-formula-isvp"
            class="mt-1 text-xl font-extrabold text-slate-900 sm:text-2xl"
          >
            ¿Qué es el Índice Sintético de Vulnerabilidad y Presión (ISVP)?
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-slate-700">
            Cuando un vecino se pregunta si su barrio está sufriendo turistificación o
            pérdida de calidad de vida urbana, un único dato aislado no basta. Un
            barrio puede tener muchos pisos turísticos, otro puede sufrir una
            saturación extrema de terrazas hosteleras y ruido nocturno, y otro puede
            tener una población mayor o de renta baja especialmente vulnerable a
            cualquier subida del alquiler.
          </p>
          <p class="mt-2 text-sm leading-relaxed text-slate-700">
            Para ofrecer una respuesta rigurosa y comparable entre los <strong>88 barrios de València</strong>,
            calculamos el <strong>ISVP (escala de 0 a 100 puntos)</strong> mediante la
            suma ponderada de cuatro vectores normalizados:
          </p>

          <!-- Ecuación visual clara -->
          <div class="mt-6 rounded-2xl border border-slate-200 bg-slate-950 p-5 text-white">
            <p class="font-mono text-xs font-bold tracking-wider text-sky-400 uppercase">
              Fórmula Matemática del Índice Compuesto (0 a 100 puntos)
            </p>
            <div class="mt-3 grid gap-3 sm:grid-cols-4">
              <div class="rounded-xl border border-slate-800 bg-slate-900 p-3.5">
                <span class="font-mono text-xl font-extrabold text-sky-400">35%</span>
                <p class="mt-1 text-xs font-bold text-white">
                  Presión Turística
                </p>
                <p class="mt-1 text-[11px] text-slate-300">
                  Densidad VUT/km², plazas y nuevas altas 2024–2026.
                </p>
              </div>
              <div class="rounded-xl border border-slate-800 bg-slate-900 p-3.5">
                <span class="font-mono text-xl font-extrabold text-amber-400">25%</span>
                <p class="mt-1 text-xs font-bold text-white">
                  Desplazamiento Comercial
                </p>
                <p class="mt-1 text-[11px] text-slate-300">
                  Saturación de terrazas/km² y variación del censo IAE.
                </p>
              </div>
              <div class="rounded-xl border border-slate-800 bg-slate-900 p-3.5">
                <span class="font-mono text-xl font-extrabold text-purple-300">20%</span>
                <p class="mt-1 text-xs font-bold text-white">
                  Brecha de Equidad y Avisos
                </p>
                <p class="mt-1 text-[11px] text-slate-300">
                  Quejas por ruido, convivencia, limpieza y deterioro viario.
                </p>
              </div>
              <div class="rounded-xl border border-slate-800 bg-slate-900 p-3.5">
                <span class="font-mono text-xl font-extrabold text-rose-400">20%</span>
                <p class="mt-1 text-xs font-bold text-white">
                  Vulnerabilidad Social
                </p>
                <p class="mt-1 text-[11px] text-slate-300">
                  Fragilidad económica y demográfica municipal amplificada.
                </p>
              </div>
            </div>
          </div>

          <!-- Tabla explicativa de los 4 niveles de alerta -->
          <div class="mt-6 space-y-3">
            <h3 class="text-base font-extrabold text-slate-900">
              Los 4 Niveles de Alerta y cuántos barrios de València están hoy en cada uno
            </h3>
            <div class="grid gap-3 sm:grid-cols-2">
              {
                ISVP_LEVELS.map((lvl) => {
                  const count = benchmarks.countsByAlert[lvl.level];
                  return (
                    <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-4">
                      <div class="flex flex-wrap items-center justify-between gap-2">
                        <span
                          class={`inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-xs font-bold ${lvl.badgeClass}`}
                        >
                          <span class={`h-2 w-2 rounded-full ${lvl.dotClass}`} aria-hidden="true" />
                          Alerta {lvl.level} ({lvl.range})
                        </span>
                        <span class="rounded bg-white px-2 py-0.5 font-mono text-xs font-bold text-slate-800 border border-slate-200">
                          {count} de 88 barrios
                        </span>
                      </div>
                      <p class="mt-2 text-xs font-bold text-slate-900">
                        {lvl.summary}
                      </p>
                      <p class="mt-1 text-xs leading-relaxed text-slate-600">
                        {lvl.citizenMeaning}
                      </p>
                    </div>
                  );
                })
              }
            </div>
          </div>
        </section>

        <!-- SECCIÓN 2: LAS 5 CAPAS DEL MAPA Y VECTORES EXPLICADOS UNO A UNO -->
        <section
          id="vectores-explicados"
          aria-labelledby="heading-vectores"
          class="scroll-mt-24 space-y-6"
        >
          <div>
            <span class="text-xs font-bold tracking-wider text-sky-800 uppercase">
              Sección 2 · Explicación Detallada de las Capas del Mapa
            </span>
            <h2
              id="heading-vectores"
              class="mt-1 text-xl font-extrabold text-slate-900 sm:text-2xl"
            >
              Cómo entender cada una de las 5 vistas cartográficas (0–100)
            </h2>
            <p class="mt-1 text-sm text-slate-600">
              Cuando cambias de capa en el mapa interactivo o pulsas sobre las barras
              de un barrio, estás visualizando uno de estos cinco indicadores:
            </p>
          </div>

          <div class="space-y-5">
            {
              CORE_VECTORS_GUIDE.map((vec) => (
                <article
                  id={vec.id}
                  class="scroll-mt-24 rounded-2xl border border-slate-200 bg-white p-6 shadow-xs"
                >
                  <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-3">
                    <div>
                      <span class="inline-block rounded-md bg-sky-100 px-2.5 py-0.5 text-xs font-bold text-sky-900">
                        {vec.badge}
                      </span>
                      <h3 class="mt-1.5 text-lg font-extrabold text-slate-900">
                        {vec.title}
                      </h3>
                    </div>
                    <div class="text-right font-mono text-xs text-slate-600">
                      <div>Fuente: <strong class="text-slate-900">{vec.sourceName}</strong></div>
                      <div>Dataset: <code class="text-sky-800">{vec.sourceDatasetId}</code></div>
                    </div>
                  </div>

                  <div class="mt-4 grid gap-4 md:grid-cols-2">
                    <div class="rounded-xl bg-slate-50 p-4 border border-slate-200/70">
                      <h4 class="text-xs font-bold tracking-wider text-slate-900 uppercase">
                        ¿Qué mide en palabras sencillas?
                      </h4>
                      <p class="mt-1.5 text-xs leading-relaxed text-slate-700">
                        {vec.plainExplanation}
                      </p>
                    </div>

                    <div class="rounded-xl bg-slate-50 p-4 border border-slate-200/70">
                      <h4 class="text-xs font-bold tracking-wider text-slate-900 uppercase">
                        ¿Por qué es clave para el barrio?
                      </h4>
                      <p class="mt-1.5 text-xs leading-relaxed text-slate-700">
                        {vec.whyItMatters}
                      </p>
                    </div>
                  </div>

                  <div class="mt-4 rounded-xl border border-slate-200 bg-white p-4">
                    <div class="flex flex-wrap items-baseline justify-between gap-2">
                      <span class="text-xs font-bold text-slate-900">
                        Regla de cálculo:
                      </span>
                      <code class="rounded bg-slate-100 px-2 py-1 font-mono text-xs text-slate-800">
                        {vec.formulaSummary}
                      </code>
                    </div>

                    <div class="mt-3 grid gap-2 sm:grid-cols-3">
                      {vec.interpretationGuide.map((step) => (
                        <div class="rounded-lg border border-slate-200/80 bg-slate-50/50 p-2.5 text-xs">
                          <div class="flex items-center justify-between gap-1">
                            <span
                              class={`rounded-full border px-2 py-0.5 text-[10px] font-bold ${step.colorClass}`}
                            >
                              {step.label}
                            </span>
                            <span class="font-mono font-bold text-slate-800">
                              {step.range}
                            </span>
                          </div>
                          <p class="mt-1.5 text-[11px] text-slate-600">
                            {step.meaning}
                          </p>
                        </div>
                      ))}
                    </div>
                  </div>

                  <p class="mt-3 rounded-xl bg-amber-50/80 border border-amber-200/80 px-4 py-2.5 text-xs text-slate-800">
                    <strong>Evidencia real en València:</strong> {vec.realWorldExample}
                  </p>
                </article>
              ))
            }
          </div>
        </section>

        <!-- SECCIÓN 3: DICCIONARIO COMPLETO DE LAS 10 VARIABLES EMPÍRICAS -->
        <section
          id="glosario-metricas"
          aria-labelledby="heading-glosario"
          class="scroll-mt-24 rounded-2xl border border-slate-200 bg-white p-6 shadow-xs sm:p-8"
        >
          <span class="text-xs font-bold tracking-wider text-sky-800 uppercase">
            Sección 3 · Diccionario Ciudadano de Datos
          </span>
          <h2
            id="heading-glosario"
            class="mt-1 text-xl font-extrabold text-slate-900 sm:text-2xl"
          >
            Glosario de todas las columnas y cifras de las tablas
          </h2>
          <p class="mt-1 text-sm text-slate-600">
            Referencia rápida para entender cada cifra que aparece en las tarjetas de
            barrio y en el explorador comparativo:
          </p>

          <div class="mt-6 grid gap-4 md:grid-cols-2">
            {
              EMPIRICAL_METRICS_GLOSSARY.map((item) => (
                <article
                  id={item.id}
                  class="flex flex-col justify-between rounded-xl border border-slate-200 bg-slate-50/60 p-4"
                >
                  <div>
                    <div class="flex flex-wrap items-center justify-between gap-2">
                      <span class="rounded bg-slate-200/80 px-2 py-0.5 text-[10px] font-bold text-slate-800 uppercase">
                        {item.category}
                      </span>
                      <code class="font-mono text-[11px] text-sky-800">
                        {item.unit}
                      </code>
                    </div>
                    <h3 class="mt-2 text-sm font-extrabold text-slate-900">
                      {item.name}
                    </h3>
                    <p class="mt-1.5 text-xs leading-relaxed text-slate-700">
                      <strong>Qué es:</strong> {item.whatIsIt}
                    </p>
                    <p class="mt-1.5 text-xs leading-relaxed text-slate-700">
                      <strong>Cómo leerlo:</strong> {item.howToReadIt}
                    </p>
                  </div>
                  <p class="mt-3 border-t border-slate-200/80 pt-2 font-mono text-[11px] text-slate-600">
                    Origen: {item.source}
                  </p>
                </article>
              ))
            }
          </div>
        </section>

        <!-- SECCIÓN 4: ARQUITECTURA DE DATOS, DUCKDB Y PONDERACIÓN ESPACIAL -->
        <section
          id="arquitectura-datos"
          aria-labelledby="heading-arquitectura"
          class="scroll-mt-24 rounded-2xl border border-slate-200 bg-white p-6 shadow-xs sm:p-8"
        >
          <span class="text-xs font-bold tracking-wider text-sky-800 uppercase">
            Sección 4 · Transparencia Algorítmica y Reproducibilidad
          </span>
          <h2
            id="heading-arquitectura"
            class="mt-1 text-xl font-extrabold text-slate-900 sm:text-2xl"
          >
            ¿Cómo procesamos y cruzamos los datos sin alterar las fuentes?
          </h2>

          <div class="mt-4 grid gap-4 md:grid-cols-3">
            <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-4">
              <span class="font-mono text-xs font-bold text-sky-800">
                PASO 1 · CAPTURA INMUTABLE
              </span>
              <h3 class="mt-1 text-sm font-extrabold text-slate-900">
                Serie temporal con firma SHA-256
              </h3>
              <p class="mt-1.5 text-xs leading-relaxed text-slate-700">
                Cada semana descargamos el CSV oficial de la GVA (<code>tur-gestur-vt</code>)
                y los datasets municipales CKAN en <code>data/raw/</code> con la
                fecha en el nombre y sin sobrescribir jamás archivos previos.
              </p>
            </div>

            <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-4">
              <span class="font-mono text-xs font-bold text-amber-800">
                PASO 2 · MOTOR SQL DUCKDB
              </span>
              <h3 class="mt-1 text-sm font-extrabold text-slate-900">
                Detección de altas y bajas (`EXCEPT`)
              </h3>
              <p class="mt-1.5 text-xs leading-relaxed text-slate-700">
                Mediante consultas SQL analíticas en <strong>DuckDB</strong>,
                comparamos las signaturas turísticas entre instantáneas consecutivas
                para descubrir qué licencias nuevas han entrado y cuáles se han dado
                de baja.
              </p>
            </div>

            <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-4">
              <span class="font-mono text-xs font-bold text-emerald-800">
                PASO 3 · INTERSECCIÓN ESPACIAL
              </span>
              <h3 class="mt-1 text-sm font-extrabold text-slate-900">
                De Código Postal (`46001`–`46026`) a Barrio
              </h3>
              <p class="mt-1.5 text-xs leading-relaxed text-slate-700">
                Los registros con código de barrio municipal (<code>coddistbar</code>)
                se cruzan directamente; el censo GVA por código postal se proyecta
                sobre los 88 barrios mediante pesos espaciales verificados con
                tests unitarios (suma exacta = <code>1,00</code>).
              </p>
            </div>
          </div>
        </section>

        <!-- SECCIÓN 5: PREGUNTAS FRECUENTES (FAQ) -->
        <section
          id="preguntas-frecuentes"
          aria-labelledby="heading-faq"
          class="scroll-mt-24 rounded-2xl border border-slate-200 bg-white p-6 shadow-xs sm:p-8"
        >
          <span class="text-xs font-bold tracking-wider text-sky-800 uppercase">
            Sección 5 · Resolución de Dudas
          </span>
          <h2
            id="heading-faq"
            class="mt-1 text-xl font-extrabold text-slate-900 sm:text-2xl"
          >
            Preguntas Frecuentes sobre el Observatorio
          </h2>

          <div class="mt-5 space-y-4">
            {
              faqItems.map((faq) => (
                <details class="group rounded-xl border border-slate-200 bg-slate-50/60 p-4 open:bg-white">
                  <summary class="cursor-pointer list-none font-bold text-slate-900 text-sm flex items-center justify-between gap-3">
                    <span>{faq.question}</span>
                    <span class="rounded-lg bg-slate-200/80 px-2 py-0.5 font-mono text-xs text-slate-700 group-open:bg-slate-900 group-open:text-white">
                      +
                    </span>
                  </summary>
                  <p class="mt-3 border-t border-slate-100 pt-3 text-xs leading-relaxed text-slate-700 sm:text-sm">
                    {faq.answer}
                  </p>
                </details>
              ))
            }
          </div>
        </section>
      </div>
    </div>
  </div>
</PublicLayout>
